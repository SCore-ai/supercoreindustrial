STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:8000,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Generate unique values with at least 32 characters. Medusa refuses to boot without them.
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
# Local Docker: postgres://USER:PASS@postgres:5432/DB?sslmode=require
# DATABASE_SSLMODE=require
DB_NAME=medusa-backend
MEDUSA_FF_TRANSLATION=true
MEDUSA_FF_VIEW_CONFIGURATIONS=true

# Zoho Books (optional — set ZOHO_BOOKS_ENABLED=true to auto-sync quote offers)
ZOHO_BOOKS_ENABLED=false
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_BOOKS_API_BASE=https://www.zohoapis.com
ZOHO_BOOKS_ACCOUNTS_BASE=https://accounts.zoho.com

# B2B email (optional fallback — prefer Admin → B2B → Settings → Email)
B2B_EMAIL_ENABLED=false
B2B_EMAIL_FROM=service@supercoresystems.co.uk
B2B_EMAIL_ADMIN=service@supercoresystems.co.uk
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
ADMIN_URL=http://localhost:9000/app
STOREFRONT_URL=http://localhost:8000
STOREFRONT_DEFAULT_COUNTRY=gb
# Public URL prefix for File module uploads (product images). Browser must reach this.
# MEDUSA_FILE_BACKEND_URL=http://localhost:9000/static
# BACKEND_URL=http://localhost:9000
ONLINE_STORE_PREVIEW_SECRET=supercore-preview-dev

# Security (System → Security)
# Storefront MFA uses the B2B email sender (Admin → B2B → Settings → Email).
# Admin MFA uses the same SMTP sender. Codes go to B2B_EMAIL_ADMIN / ADMIN_MFA_EMAIL.
# ADMIN_MFA_EMAIL=service@supercoresystems.co.uk
# ADMIN_MFA_BYPASS=true
# MFA_PROVIDER=totp
# SSO_AUTH_PROVIDER=google
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ISSUER=
# SSO_AUTHORIZE_URL=
# SSO_REDIRECT_URI=http://localhost:8000/account/sso/callback
# SSO_SCOPES=openid email profile
# FIELD_ENCRYPTION_KEY=
# Stripe (System → Payments). Never commit real keys. Restart Medusa after changes.
# STRIPE_API_KEY=sk_test_...   # or rk_test_ restricted key; sk_live_ blocked in development
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CAPTURE=false
# STRIPE_AUTOMATIC_PAYMENT_METHODS=true
# STRIPE_AUTO_ENABLE_REGIONS=true
# STRIPE_ALLOW_LIVE=false
